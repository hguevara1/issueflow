{# Esta plantilla hereda de base.html.twig #}
{% extends "base.html.twig" %}

{# 
    Sobreescribimos el título de la página, usamos la variable projectName, la
    cual se pasa desde el controlador.
#}
{% block title %}{{projectName}}{% endblock %}

{# Inserto el cuerpo de la página de inicio #}
{% block body %}
    <section class="hero">
        <p class="eyebrow">IFCT092PO . Proyecto del curso</p>
        {# projectName es una variable que se pasa desde el controlador #}
        <h1 class="title">{{projectName }}</h1>
        {# message es una variable que se pasa desde el controlador #}
        <p class="subtitle">{{ message }}</p>
        <p class="subtitle"> <a href="{{ path('app_ticket_index') }}">Ver incidencias</a></p>
    </section>
{% endblock %}