<article class="ticket-card">
    <div>
        <p class="ticket-id">#{{ ticket.code }}</p>
        <h2>{{ ticket.title }}</h2>
        <p>Prioridad: <strong>{{ ticket.priority.label }}</strong></p>
        <p>Estado: <strong>{{ ticket.status.label }}</strong></p>
        <p>
            Categoría:
            {% if ticket.category %}
                {{ ticket.category.name }}
            {% else %}
                Sin categoría
            {% endif %}
        </p>
        <p>
            Asignado a:
            {% if ticket.assignee %}
                {{ ticket.assignee.name }}
            {% else %}
                No hay nadie asignado
            {% endif %}
        </p>
    </div>

    <a href="{{ path('app_ticket_show', {code: ticket.code}) }}" class="button button-outline">Ver detalles</a>
</article>
