{# Esta plantilla hereda de base.html.twig #}
{% extends "base.html.twig" %}

{# 
    Sobreescribimos el título de la página, usamos la variable title, la
    cual se pasa desde el controlador.
#}
{% block title %}{{title}}{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <p class="eyebrow">IssueFlow</p>
            <h1>{{title}}</h1>
        </div>
        {% if is_granted('ROLE_AGENT') %}
            <a href="{{ path('app_ticket_new') }}" class="button">+ Nueva incidencia</a>
        {% endif %}
        <p class="counter">Hay {{ ticketPage.getTotalCount() }} incidencias</p>
    </div>

    <section class="filter-card">
        {{ form_start(filterForm, {'attr': {'class': 'filter-form'}}) }}
            {{ form_row(filterForm.query, {'attr': {'placeholder': 'Buscar por título o descripción'}}) }}
            {{ form_row(filterForm.priority) }}
            {{ form_row(filterForm.status) }}
            {{ form_row(filterForm.category) }}
            <div class="filter-actions">
                {{form_widget(filterForm.filter)}}
                <a class="button button-outline" href="{{ path('app_ticket_index') }}">
                    Limpiar filtros
                </a>
            </div>
        {{ form_end(filterForm) }}
    </section>
    {# Si hay un ticket creado recientemente, mostramos un mensaje de éxito. #}
    {% if lastTicketCode is not null %}
        <div class="flash-success">
            Última incidencia creada: 
            <a href="{{ path('app_ticket_show', {'code': lastTicketCode}) }}">{{ lastTicketCode }}</a>
        </div>
    {% endif %}
    <div class="ticket-list">
        {% for t in ticketPage.getItems() %}
            {# <p>{{ ticket.id }} - {{ ticket.title }} - Prioridad: {{ ticket.priority }}</p> #}
            {% include 'ticket/_ticket_card.html.twig' with {'ticket': t} only %}
        {% else %}
            <p>No hay incidencias que coincidan con los criterios de búsqueda.</p>
        {% endfor %}
    </div>
    
        {% if ticketPage.hasToPaginate() %}
            {% set queryParameters = app.request.query.all %}

            <nav class="pagination">
                {% if ticketPage.hasPreviousPage() %}
                  <a
                    href="{{ path('app_ticket_index', queryParameters|merge({page: ticketPage.getPageNumber() - 1})) }}"
                    class="button button-outline">
                    ← Anterior
                    </a>  
                {% endif %}
                <span>
                    Página {{ ticketPage.getPageNumber() }} de {{ ticketPage.getPageCount() }}
                </span>
                {% if ticketPage.hasNextPage() %}
                  <a
                    href="{{ path('app_ticket_index', queryParameters|merge({page: ticketPage.getPageNumber() + 1})) }}"
                    class="button button-outline">
                    Siguiente →
                    </a>  
                {% endif %}
            </nav>
            
        {% endif %}
    
{% endblock %}
